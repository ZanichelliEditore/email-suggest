# The consumer's .npmrc as the README documents it. Values come from the
# environment (make consumer-check reads them from the gitignored .env), so
# this tracked file names no account and holds no token (AGENTS.md rule 2).
@zanichelli:registry=https://npm.fury.io/${GEMFURY_ACCOUNT}/
//npm.fury.io/${GEMFURY_ACCOUNT}/:_authToken=${GEMFURY_TOKEN}
